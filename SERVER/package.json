    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.2.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.2.0",
    "joi": "^17.13.4",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.2",
    "muhammara": "^6.0.4",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.5",
    "rrule": "^2.7.1",
    "sanitize-html": "^2.17.5",
    "server": "file:",
    "signature_pad": "^5.1.3",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
