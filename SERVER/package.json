  "devDependencies": {
    "baseline-browser-mapping": "^2.9.7",
    "cross-env": "^7.0.3",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.7",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "tar": "^7.5.16",
    "cookie": "^0.7.0",
    "fast-xml-parser": "^5.5.6",
    "uuid": "^11.1.1",
    "js-yaml": "^4.1.2",
    "qs": "^6.15.2",
    "muhammara": {
      "tar": "^7.5.16",
      "@mapbox/node-pre-gyp": {
