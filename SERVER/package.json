{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "nodemon .",
    "start:quiet": "cross-env NODE_OPTIONS=--no-deprecation nodemon .",
    "test": "jest --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "migrate:normalize-recipient-ids": "node ./scripts/normalize-recipient-userids.js",
    "migrate:cos-proposal-index": "node ./migrations/migrate-cos-proposal-index.js",
    "seed:departmentdivisionmappings": "node ./migrations/seed-departmentdivisionmappings.js",
    "encrypt:env": "node ./tools/encryptEnv.js",
    "pnpki:build-bundle:ps": "powershell -ExecutionPolicy Bypass -File ./tools/build-pnpki-bundle.ps1",
    "pnpki:verify-bundle": "node ./tools/verifyPnpkiBundle.js",
    "pnpki:verify-bundle:ps": "powershell -ExecutionPolicy Bypass -File ./tools/verify-pnpki.ps1",
    "format": "prettier --write \"**/*.{js,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,json,md}\" --ignore-path .prettierignore"
  },
  "dependencies": {
    "agenda": "^5.0.0",
    "archiver": "^6.0.2",
    "axios": "^1.15.3",
    "bcrypt": "^6.0.0",
