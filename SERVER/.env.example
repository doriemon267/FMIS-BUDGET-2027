# 🔒 FMIS Budget System - Secure Environment Configuration
# Copy this file to .env and configure with your actual values
# NEVER commit .env file to version control

# ================================
# 🚨 CRITICAL SECURITY SETTINGS
# ================================

# Node Environment (REQUIRED)
NODE_ENV=production

# JWT Secret Key (REQUIRED - MUST BE STRONG)
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=your-super-secure-jwt-secret-key-here-min-256-bits-length-required

# Session Secret (REQUIRED - MUST BE STRONG)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-session-secret-key-here-different-from-jwt

# ================================
# 🔗 DATABASE CONFIGURATION
# ================================

# MongoDB Connection URL (REQUIRED)
# Format: mongodb://username:password@host:port/database
# For Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
DATABASE_URL=mongodb://localhost:27017/fmis_budget_db

# Optional: MSSQL (for external systems) - Set ENABLE_MSSQL=true to enable
ENABLE_MSSQL=false
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=fmis_external
MSSQL_USER=your_mssql_user
MSSQL_PASSWORD=your_mssql_password
MSSQL_ENCRYPT=false
MSSQL_EXTERNAL_TABLE_NAME=ExternalProposals
MSSQL_SALARYTABLE_TABLE_NAME=SalaryTable
MSSQL_SNI_HOST=
MSSQL_STRICT_SNI_FAIL=false
MSSQL_SUPPRESS_SNI_WARNING=false
SUPPRESS_NODE_DEPRECATION_WARNINGS=

# ================================
# 🔐 AUTHENTICATION SERVICE
# ================================

# External Authentication API (REQUIRED for production)
# This MUST be set in production - no mock auth allowed
ACCOUNT_USER_API_URL=https://your-auth-service.com/api/user

# Auth server get-user URL (for budget server to fetch roles when JWT/DB have none)
# Use when auth + budget are separate; roles come from get-user
# AUTH_SERVER_GET_USER_URL=https://your-auth-service.com/api/get-user
# Or set AUTH_SERVER_URL and /api/get-user will be appended:
# AUTH_SERVER_URL=https://your-auth-service.com

# Development Mock Auth Flag (DEVELOPMENT ONLY)
# Set to 'true' ONLY in development, NEVER in production
ALLOW_MOCK_AUTH=false
MONGODB_URI=mongodb://localhost:27017/fmistest
MONGODB_BUDGET_URL=mongodb://localhost:27017/fmistest
MONGODB_MAIN_URL=mongodb://localhost:27017/fmis_main

# ================================
# 🌐 SERVER CONFIGURATION
# ================================

# Application Port
APP_PORT=5000

# Cookie Domain (for budget.nia.gov.ph + budget-server.nia.gov.ph - use .nia.gov.ph)
# Enables auth cookie to be sent to both subdomains (WebSocket, API)
# COOKIE_DOMAIN=.nia.gov.ph

# If your auth server sets a different cookie name, set it here (default: jwtToken, authToken)
# AUTH_COOKIE_NAME=session

# Log when "No token provided" (cookie names present, no values): set to 1 or true for debugging
# LOG_AUTH_DEBUG=0

# Allowed CORS Origins (REQUIRED)
# Add your actual frontend domains
CLIENT1=https://your-frontend-domain.com
CLIENT2=https://your-admin-domain.com
CLIENT3=https://your-backup-domain.com

# ================================
# 📁 FILE UPLOAD SETTINGS
# ================================

# Maximum file size in MB (default: 10MB)
MAX_FILE_SIZE_MB=10

# Upload directory (if using disk storage)
UPLOAD_DIR=./uploads

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=.xlsx,.xls,.csv

# ================================
# 🛡️ SECURITY SETTINGS
# ================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Upload Rate Limiting
UPLOAD_RATE_LIMIT_WINDOW_MS=300000
UPLOAD_RATE_LIMIT_MAX_UPLOADS=3

# Session Configuration
SESSION_MAX_AGE=86400000

# IP Whitelist for admin operations (comma-separated)
# Example: 192.168.1.100,10.0.0.50
ADMIN_IP_WHITELIST=

# ================================
# 📊 MONITORING & LOGGING
# ================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Enable Security Audit Logging
ENABLE_AUDIT_LOGGING=true

# ================================
# 🔄 BACKUP SETTINGS
# ================================

# Backup encryption key
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key-here

# Backup storage location
# For development (relative path): ./backups
# For production Linux: /var/backups/fmis-budget
# For production Windows: C:\Backups\FMIS-Budget
# For cloud storage: /mnt/backup-volume/fmis
BACKUP_STORAGE_PATH=./backups

# ================================
# 📧 NOTIFICATION SETTINGS
# ================================

# Email service for notifications (alternative to SMTP_* settings)
MAIL_HOST=smtp.your-email-service.com
MAIL_PORT=587
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME=FMIS Budget System

# Test email recipient for development
TEST_EMAIL_RECIPIENT=test@example.com

# Email service for security alerts (legacy SMTP settings)
SMTP_HOST=smtp.your-email-service.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-email-password
SECURITY_ALERT_EMAIL=security@your-domain.com

# ================================
# 🔍 OPTIONAL SECURITY FEATURES
# ================================

# Enable additional security headers
ENABLE_ADVANCED_SECURITY=true

# Content Security Policy
CSP_REPORT_URI=https://your-domain.com/csp-report

# Enable HTTPS enforcement (production only)
FORCE_HTTPS=true

# API Key for external services (if needed)
EXTERNAL_API_KEY=your-external-api-key-here

# ================================
# ✍️ PNPKI DIGITAL SIGNATURE
# ================================
# Enforce cryptographic digital signature verification on workflow approvals
PNPKI_ENFORCE_SIGNATURE=false

# Absolute path to trusted PNPKI CA bundle (PEM chain)
# Example (Windows): D:\certs\pnpki-trust-bundle.pem
PNPKI_TRUST_BUNDLE_PATH=

# ================================
# 📱 CLIENT CONFIGURATION
# ================================
# These are used by the frontend application

# API Server URL
VITE_SERVER_URL=https://your-api-domain.com

# Authentication Service URLs
VITE_AUTH_SERVER_URL=https://your-auth-service.com
VITE_AUTH_CLIENT_URL=https://your-auth-frontend.com

# Client-side encryption key
VITE_SECRET_KEY=your-client-encryption-key-here

# Enable development features
VITE_ENABLE_DEV_TOOLS=false

# ================================
# 🔧 DEVELOPMENT SETTINGS
# ================================
# Only used in development environment

# Enable debug logging
DEBUG=fmis:*

# Development database
DEV_DATABASE_URL=mongodb://localhost:27017/fmis_budget_dev

# Disable some security features for development
DEV_DISABLE_RATE_LIMIT=false
DEV_DISABLE_CORS=false
# NODE_OPTIONS can be used to control Node runtime flags like --no-deprecation
NODE_OPTIONS=--no-deprecation

# ================================
# ⚠️ SECURITY REMINDERS
# ================================
# 1. Keep this file secure and never commit to version control
# 2. Use strong, unique passwords and keys
# 3. Rotate secrets regularly
# 4. Monitor access logs regularly
# 5. Keep dependencies updated
# 6. Use HTTPS in production
# 7. Implement proper backup procedures
# 8. Test security configurations regularly
# ================================
