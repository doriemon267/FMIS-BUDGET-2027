# Used by: npm run build (vite build --mode production)
# DO NOT add localhost/dev URLs here.

# App
VITE_APP_TITLE=OSBPIS
VITE_APP_FULL_TITLE=FMIS - ONLINE SUBMISSION OF BUDGET PROPOSAL INFORMATION SYSTEM

# Prod mode flag
VITE_PRODUCTION_MODE=true

# Auth (NIA SSO)
VITE_LOGIN_REDIRECT_URL=https://accounts.nia.gov.ph/Account/Login
VITE_CLIENT_ID=2b4ffb22-5827-49fb-97c1-df7564c6a4cc
VITE_AUTH_SERVER_URL_PROD=https://fmis.nia.gov.ph
VITE_AUTH_CLIENT_URL_PROD=https://fmis.nia.gov.ph
VITE_BUDGET_SERVER_URL_PROD=https://budget-server.nia.gov.ph
VITE_BUDGET_CLIENT_URL_PROD=https://budget.nia.gov.ph

# Chat: use polling to avoid WebSocket upgrade issues
VITE_CHAT_SOCKET_URL=https://budget-server.nia.gov.ph
VITE_CHAT_SOCKET_TRANSPORT=polling

# UI toggles
VITE_HIDE_BUDGET_SUMMARY=true
VITE_HIDE_INCOME_LOCK_BANNER=true
VITE_HIDE_ACCESS_INFO_BANNERS=true

VITE_PNPKI_SIGNING_ENABLED=false
VITE_PNPKI_SIGNER_MODE=disabled
