# App
VITE_APP_TITLE=OSBPIS
VITE_APP_FULL_TITLE=FMIS - ONLINE SUBMISSION OF BUDGET PROPOSAL INFORMATION SYSTEM

# Prod mode flag
VITE_PRODUCTION_MODE=true

# Auth (NIA SSO)
VITE_LOGIN_REDIRECT_URL=https://accounts.nia.gov.ph/Account/Login
