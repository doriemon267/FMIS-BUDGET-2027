# 🔒 FMIS Budget System - Client Environment Configuration
# Copy this file to .env and configure with your actual values
# NEVER commit .env file to version control

# ================================
# 🌐 API CONFIGURATION
# ================================

# Backend API Server URL (REQUIRED)
VITE_SERVER_URL=https://your-api-domain.com

# Optional: explicit Socket.IO host for chat (without /api),
# useful when frontend and backend are on different domains.
# If blank, app auto-resolves from VITE_SERVER_URL_DEV (dev)
# or VITE_BUDGET_SERVER_URL_PROD / same-origin (prod).
VITE_CHAT_SOCKET_URL=

# Optional: force chat transport mode.
# - polling: disables websocket attempts (removes websocket warning when proxy blocks upgrade)
# - websocket: prefer websocket then polling fallback
# - blank: app defaults to polling in production, websocket+polling in development
VITE_CHAT_SOCKET_TRANSPORT=

# Authentication Service URLs (REQUIRED)
VITE_AUTH_SERVER_URL=https://your-auth-service.com
VITE_AUTH_CLIENT_URL=https://your-auth-frontend.com

# NIA SSO: Login redirect - MUST be Account/Login, NOT /Manage
# VITE_LOGIN_REDIRECT_URL=https://accounts.nia.gov.ph/Account/Login

# ================================
# 🔐 SECURITY CONFIGURATION
# ================================

# Client-side encryption key for sensitive data (REQUIRED)
# Generate with: openssl rand -base64 32
VITE_SECRET_KEY=your-client-encryption-key-here-32-chars-minimum

# ================================
# 🛠️ DEVELOPMENT SETTINGS
# ================================

# Build output path (used by vite.config.js):
# - false/blank → build goes to C:\inetpub\wwwroot\fmis-budget-client (dev/staging)
# - true        → build goes to ./dist (production)
VITE_PRODUCTION_MODE=false

# Enable development tools (DEVELOPMENT ONLY)
VITE_ENABLE_DEV_TOOLS=false

# Enable console debugging
VITE_DEBUG_MODE=false

# Skip SSL verification (DEVELOPMENT ONLY)
VITE_SKIP_SSL_VERIFY=false

# Enable PNPKI workflow signing on client (requires window.PNPKISigner bridge)
VITE_PNPKI_SIGNING_ENABLED=false

# PNPKI signer bridge mode: blank|mock|http
# - mock: local dev fake signer (no real cryptographic certificate chain)
# - http: call external desktop signer bridge service
VITE_PNPKI_SIGNER_MODE=

# Used when VITE_PNPKI_SIGNER_MODE=http
VITE_PNPKI_SIGNER_BRIDGE_URL=http://127.0.0.1:17890

# ================================
# 🎨 UI CONFIGURATION
# ================================

# Application title
VITE_APP_TITLE=FMIS Budget Management System

# Theme configuration
VITE_DEFAULT_THEME=light

# Language settings
VITE_DEFAULT_LANGUAGE=en

# ================================
# 📊 MONITORING & ANALYTICS
# ================================

# Error tracking service
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# Analytics tracking ID
VITE_ANALYTICS_ID=your-analytics-id

# ================================
# ⚠️ SECURITY REMINDERS
# ================================
# 1. Never store sensitive secrets in client environment
# 2. All VITE_ variables are exposed to the browser
# 3. Use HTTPS for all production URLs
# 4. Validate all data received from the server
# 5. Keep dependencies updated
# ================================
