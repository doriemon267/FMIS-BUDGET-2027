# 🔒 FMIS Budget System - Client Environment Configuration
# Copy this file to .env and configure with your actual values
# NEVER commit .env file to version control

# ================================
# 🌐 API CONFIGURATION
# ================================

# Backend API Server URL (REQUIRED)
VITE_SERVER_URL=https://your-api-domain.com

# Authentication Service URLs (REQUIRED)
VITE_AUTH_SERVER_URL=https://your-auth-service.com
VITE_AUTH_CLIENT_URL=https://your-auth-frontend.com

# ================================
# 🔐 SECURITY CONFIGURATION
# ================================

# Client-side encryption key for sensitive data (REQUIRED)
# Generate with: openssl rand -base64 32
VITE_SECRET_KEY=your-client-encryption-key-here-32-chars-minimum

# ================================
# 🛠️ DEVELOPMENT SETTINGS
# ================================

# Enable development tools (DEVELOPMENT ONLY)
VITE_ENABLE_DEV_TOOLS=false

# Enable console debugging
VITE_DEBUG_MODE=false

# Skip SSL verification (DEVELOPMENT ONLY)
VITE_SKIP_SSL_VERIFY=false

# ================================
# 🎨 UI CONFIGURATION
# ================================

# Application title
VITE_APP_TITLE=FMIS Budget Management System

# Theme configuration
VITE_DEFAULT_THEME=light

# Language settings
VITE_DEFAULT_LANGUAGE=en

# ================================
# 📊 MONITORING & ANALYTICS
# ================================

# Error tracking service
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# Analytics tracking ID
VITE_ANALYTICS_ID=your-analytics-id

# ================================
# ⚠️ SECURITY REMINDERS
# ================================
# 1. Never store sensitive secrets in client environment
# 2. All VITE_ variables are exposed to the browser
# 3. Use HTTPS for all production URLs
# 4. Validate all data received from the server
# 5. Keep dependencies updated
# ================================
