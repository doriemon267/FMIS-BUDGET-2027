# Local development with custom domains (budget.fmis.local / main.fmis.local)
# Copy to .env.development.local and ensure hosts file has:
#   127.0.0.1 budget.fmis.local
#   127.0.0.1 main.fmis.local
#
# Leave VITE_PRODUCTION_MODE blank so DEV URLs are used.

# Budget app (this client)
VITE_CLIENT_URL_DEV=http://budget.fmis.local:3005
VITE_SERVER_URL_DEV=http://budget.fmis.local:5005

# Main FMIS auth (for SSO / login redirect)
VITE_AUTH_SERVER_URL_DEV=http://main.fmis.local:5000
VITE_AUTH_CLIENT_URL_DEV=http://main.fmis.local:3000
