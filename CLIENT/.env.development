# Used by: npm run build:local (vite build --mode development)
# DO NOT add production URLs here.

# App
VITE_APP_TITLE=OSBPIS
VITE_APP_FULL_TITLE=FMIS - ONLINE SUBMISSION OF BUDGET PROPOSAL INFORMATION SYSTEM

# Dev mode flag (blank = false = use _DEV URLs)
VITE_PRODUCTION_MODE=

# Budget server
VITE_CLIENT_URL_DEV=http://localhost:5005
VITE_SERVER_URL_DEV=http://localhost:5005
VITE_CHAT_SOCKET_URL=http://localhost:5005
VITE_CHAT_SOCKET_TRANSPORT=

# Auth server (main)
VITE_AUTH_SERVER_URL_DEV=http://localhost:5000
VITE_AUTH_CLIENT_URL_DEV=http://localhost:5000
VITE_LOGIN_REDIRECT_URL_DEV=http://localhost:5000

# UI toggles
VITE_HIDE_BUDGET_SUMMARY=true
VITE_HIDE_INCOME_LOCK_BANNER=true
VITE_HIDE_ACCESS_INFO_BANNERS=true

VITE_PNPKI_SIGNING_ENABLED=false
VITE_PNPKI_SIGNER_MODE=disabled
