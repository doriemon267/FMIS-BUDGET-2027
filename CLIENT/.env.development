# Auto-loaded by `vite dev` — committed to git (localhost values only, not sensitive)
# For custom local domains (budget.fmis.local), use .env.development.local instead.

# Development mode flag (blank = falsy = use _DEV URLs)
VITE_PRODUCTION_MODE=

# Local server URLs
VITE_CLIENT_URL_DEV=http://localhost:5005
VITE_SERVER_URL_DEV=http://localhost:5005
VITE_AUTH_SERVER_URL_DEV=http://localhost:5000
VITE_AUTH_CLIENT_URL_DEV=http://localhost:5000
VITE_LOGIN_REDIRECT_URL_DEV=http://localhost:3000
VITE_CHAT_SOCKET_URL=http://localhost:5005

# Dev: disable forced polling so DevTools shows WS
VITE_CHAT_SOCKET_TRANSPORT=
